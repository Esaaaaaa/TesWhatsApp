# ID Grup WhatsApp yang diizinkan (pisahkan dengan koma jika lebih dari 1).
# Kosongkan jika ingin bot merespon di semua grup atau chat pribadi.
ALLOWED_GROUP_IDS=

# Nomor WA Admin yang berhak menjalankan perintah /tambah, /bayar, /selesai, dll (format 62..., pisahkan dengan koma).
# Kosongkan jika siapapun boleh menjalankan perintah.
ADMIN_NUMBERS=

# ID Spreadsheet Google Sheets Administrasi Joki Tugas:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Nama Tab/Sheet di dalam spreadsheet (default: Sheet1)
TASKS_SHEET_NAME=Sheet1

# Nomor WhatsApp Bot untuk meminta kode pairing (angka saja diawali 62)
WHATSAPP_PHONE_NUMBER=

# Path ke file JSON Google Service Account kredensial (lokal)
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# ATAU jika deploy di cloud (Railway / VPS), gunakan teks JSON langsung:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Folder sesi login WhatsApp (default: auth_info)
AUTH_STATE_DIR=auth_info

# API Key Google Gemini (dari Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
